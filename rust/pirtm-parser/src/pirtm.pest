WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

ident = @{ ("_" | ASCII_ALPHANUMERIC)+ }
integer = @{ ASCII_DIGIT+ }
float = @{ integer ~ "." ~ integer }
version = { integer ~ "." ~ integer ~ ("." ~ integer )? }
ensemble_path = { ident ~ ("-" ~ ident)* }
item_path = { ident ~ ("::" ~ ident)* }

// Packaging Envelope Keywords (Pest Packaging Authority - ADR-014)
kw_ensemble = { "ensemble" }
kw_matrix   = { "matrix" }
kw_lambdas  = { "lambdas" }
kw_theorem  = { "theorem" }
kw_use      = { "use" }

program      = { SOI ~ (ensemble_decl | import_stmt | matrix_decl | lambdas_decl | theorem_decl)* ~ EOI }
ensemble_decl = { kw_ensemble ~ WHITESPACE+ ~ ident ~ WHITESPACE* ~ version }
import_stmt  = { kw_use ~ WHITESPACE+ ~ ensemble_path ~ ("::" ~ item_path)? ~ (WHITESPACE+ "as" ~ WHITESPACE+ ident)? ~ (WHITESPACE+ "with" ~ WHITESPACE+ "spectral_budget" ~ WHITESPACE* "=" ~ WHITESPACE* float)? ~ ";" }

// Packaging Envelope Declarations (Envelope-Only Grammar - ADR-014 Addendum)
matrix_decl  = { kw_matrix ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ expr }
lambdas_decl = { kw_lambdas ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ expr }
theorem_decl = { kw_theorem ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ expr }

expr = { ident | integer | float }
