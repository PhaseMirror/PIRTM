WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

ident = @{ ("_" | ASCII_ALPHANUMERIC)+ }
integer = @{ ASCII_DIGIT+ }
float = @{ integer ~ "." ~ integer }
string_lit = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
version = { integer ~ "." ~ integer ~ ("." ~ integer )? }
ensemble_path = { ident ~ ("-" ~ ident)* }
item_path = { ident ~ ("::" ~ ident)* }

// Packaging Envelope Keywords (Pest Packaging Authority - ADR-014)
kw_let      = { "let" }
kw_ensemble = { "ensemble" }
kw_matrix   = { "matrix" }
kw_lambdas  = { "lambdas" }
kw_theorem  = { "theorem" }
kw_use      = { "use" }
header_delimiter = { "---" }

envelope_header  = { SOI ~ (ensemble_decl | import_stmt | matrix_decl | lambdas_decl | theorem_decl)* ~ header_delimiter }
header_only_file = { SOI ~ (ensemble_decl | import_stmt | matrix_decl | lambdas_decl | theorem_decl)* ~ EOI }
program          = { envelope_header | header_only_file }

ensemble_decl = { kw_ensemble ~ WHITESPACE+ ~ ident ~ WHITESPACE* ~ version }
import_stmt  = { kw_use ~ WHITESPACE+ ~ ensemble_path ~ ("::" ~ item_path)? ~ (WHITESPACE+ "as" ~ WHITESPACE+ ident)? ~ (WHITESPACE+ "with" ~ WHITESPACE+ "spectral_budget" ~ WHITESPACE* "=" ~ WHITESPACE* float)? ~ ";" }

// Packaging Envelope Declarations (Envelope-Only Grammar - ADR-014 Addendum)
matrix_decl  = { (kw_let ~ WHITESPACE+)? ~ kw_matrix ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ expr ~ ";"? }
lambdas_decl = { (kw_let ~ WHITESPACE+)? ~ kw_lambdas ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ expr ~ ";"? }

theorem_anchor = { string_lit | (ident ~ ("." ~ ident)*) }
theorem_decl   = { (kw_let ~ WHITESPACE+)? ~ kw_theorem ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ theorem_anchor ~ ";"? }

// Exact Rational Tuple Value Grammar (PosRat in Q)
tuple_pair = { "(" ~ WHITESPACE* ~ integer ~ WHITESPACE* ~ "," ~ WHITESPACE* ~ integer ~ WHITESPACE* ~ ")" }
tuple_row  = { "(" ~ WHITESPACE* ~ tuple_pair ~ (WHITESPACE* ~ "," ~ WHITESPACE* ~ tuple_pair)* ~ WHITESPACE* ~ ")" }
matrix_val = { "(" ~ WHITESPACE* ~ tuple_row ~ (WHITESPACE* ~ "," ~ WHITESPACE* ~ tuple_row)* ~ WHITESPACE* ~ ")" }

expr = { matrix_val | tuple_row | tuple_pair | string_lit | ident | integer | float }
